<div class="education">
  <h2>Education</h2>
  {% if site.data.education %}
    <div
      class="education-list"
      style="
        border-left: 2px solid var(--global-divider-color);
        margin-top: 1.75rem;
        margin-left: 0.35rem;
        padding-left: 1.25rem;
      "
    >
      {% for edu in site.data.education %}
        <div class="education-entry" style="position: relative; margin-bottom: {% if forloop.last %}0{% else %}1.75rem{% endif %};">
          <span
            style="
              position: absolute;
              left: -1.55rem;
              top: 0.45rem;
              width: 0.55rem;
              height: 0.55rem;
              border-radius: 50%;
              background: var(--global-theme-color);
              box-shadow: 0 0 0 3px var(--global-bg-color);
            "
          ></span>

          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; align-items: baseline;">
            <div style="font-weight: 700; font-size: 1.05rem; color: var(--global-text-color);">
              {{ edu.degree }}
            </div>
            <div class="edu-period" style="font-size: 0.9rem; color: var(--global-text-color-light);">
              {{ edu.period }}
            </div>
          </div>

          {% if edu.school %}
            <div style="margin-top: 0.3rem; font-size: 0.95rem; color: var(--global-text-color);">
              {{ edu.school }}
            </div>
          {% endif %}

          <div style="margin-top: 0.15rem; font-size: 0.92rem; color: var(--global-text-color-light);">
            {{ edu.org }}{% if edu.location %} · {{ edu.location }}{% endif %}
          </div>

          {% if edu.lab or edu.advisor %}
            <div style="margin-top: 0.2rem; font-size: 0.9rem; color: var(--global-text-color-light);">
              {% if edu.lab %}{{ edu.lab }}{% endif %}{% if edu.lab and edu.advisor %} · {% endif %}{% if edu.advisor %}Advised by {{ edu.advisor }}{% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
