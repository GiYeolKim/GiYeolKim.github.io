<div class="experiences">
  <h2>Experience</h2>
  {% if site.data.experiences %}
    <div
      class="experience-list"
      style="
        border-left: 2px solid var(--global-divider-color);
        margin-top: 1.75rem;
        margin-left: 0.35rem;
        padding-left: 1.25rem;
      "
    >
      {% for exp in site.data.experiences %}
        <div class="experience-entry" style="position: relative; margin-bottom: {% if forloop.last %}0{% else %}1.75rem{% endif %};">
          <span
            style="
              position: absolute;
              left: -1.55rem;
              top: 0.45rem;
              width: 0.55rem;
              height: 0.55rem;
              border-radius: 50%;
              background: var(--global-theme-color);
              box-shadow: 0 0 0 3px var(--global-bg-color);
            "
          ></span>

          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; align-items: baseline;">
            <div style="font-weight: 700; font-size: 1.05rem; color: var(--global-text-color);">
              {{ exp.role }}
            </div>
            <div style="font-size: 0.9rem; color: var(--global-text-color-light); white-space: nowrap;">
              {{ exp.period }}
            </div>
          </div>

          <div style="margin-top: 0.3rem; font-size: 0.95rem; color: var(--global-text-color);">
            {{ exp.org }}{% if exp.location %}<span style="color: var(--global-text-color-light);"> · {{ exp.location }}</span>{% endif %}
          </div>

          {% if exp.description or exp.note %}
            <div style="margin-top: 0.2rem; font-size: 0.9rem; color: var(--global-text-color-light);">
              {% if exp.description %}<span style="color: var(--global-text-color);">Research:</span> {{ exp.description }}{% endif %}{% if exp.description and exp.note %} · {% endif %}{% if exp.note %}<em>{{ exp.note }}</em>{% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
