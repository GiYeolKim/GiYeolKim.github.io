<div class="reviewer-experiences">
  <h2>Reviewer Experiences</h2>
  {% if site.data.reviewer_experiences %}
    {% for group in site.data.reviewer_experiences %}
      <div style="margin-bottom: 1.25rem;">
        <div style="font-weight: 700; margin-bottom: 0.4rem;">{{ group.category }}</div>
        <ul style="margin: 0; padding-left: 1.25rem; list-style-type: square;">
          {% for item in group.items %}
            <li style="margin-bottom: 0.2rem;">{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  {% endif %}
</div>
