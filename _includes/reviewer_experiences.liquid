<div class="reviewer-experiences">
  <h2>Reviewer Activities</h2>
  {% if site.data.reviewer_experiences %}
    <div style="margin-top: 1.75rem; font-size: 1rem; line-height: 1.7;">
      {% for item in site.data.reviewer_experiences %}
        {{ item }}{% unless forloop.last %}, {% endunless %}
      {% endfor %}
    </div>
  {% endif %}
</div>
